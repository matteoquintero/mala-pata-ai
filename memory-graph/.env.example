# .env.example — template de config para mala-pata-memory
# Copiar a .env y completar con valores reales. .env NO se commitea.

# ─── Neo4j (grafo local) ─────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-in-.env

# ─── LLM provider para extracción de entidades/relaciones ────────────────
# Uno de: anthropic | openai | google | ollama
LLM_PROVIDER=anthropic

# Anthropic (recomendado — Haiku 4.5 barato)
ANTHROPIC_API_KEY=sk-ant-...
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001

# OpenAI (alternativa)
# OPENAI_API_KEY=sk-...
# GRAPHITI_LLM_MODEL=gpt-4o-mini

# Google Gemini (alternativa)
# GOOGLE_API_KEY=...
# GRAPHITI_LLM_MODEL=gemini-2.0-flash

# Ollama local (alternativa gratis — usa endpoint OpenAI-compat)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# GRAPHITI_LLM_MODEL=llama3.1:8b

# ─── Fuente de datos (engram) ────────────────────────────────────────────
# Cómo el ingest lee observations de engram — completar según pluggability decidida
ENGRAM_SOURCE=mcp
# ENGRAM_MCP_ENDPOINT=stdio-o-http-según-config

# ─── MCP server ──────────────────────────────────────────────────────────
MCP_SERVER_NAME=mala-pata-memory
MCP_SERVER_TRANSPORT=stdio
